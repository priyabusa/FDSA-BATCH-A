#include <iostream>
using namespace std;

int main()
{
    int marks[] = {65, 32, 78, 45, 90, 21};
    int n = 6;

    for(int i = 0; i < n - 1; i++)
    {
        int min = i;

        for(int j = i + 1; j < n; j++)
        {
            if(marks[j] < marks[min])
                min = j;
        }

        swap(marks[i], marks[min]);
    }

    cout << "Sorted marks: ";

    for(int i = 0; i < n; i++)
        cout << marks[i] << " ";

    return 0;
}
