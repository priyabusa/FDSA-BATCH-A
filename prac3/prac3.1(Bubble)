#include <iostream>
using namespace std;

int main()
{
    int marks[] = {65, 32, 78, 45, 90, 21};
    int n = 6;


    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - i - 1; j++)
        {
            if(marks[j] > marks[j + 1])
            {
                int temp = marks[j];
                marks[j] = marks[j + 1];
                marks[j + 1] = temp;
            }
        }
    }

    cout << "Sorted marks using Bubble Sort: ";

    for(int i = 0; i < n; i++)
    {
        cout << marks[i] << " ";
    }

    return 0;
}
