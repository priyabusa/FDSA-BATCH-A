#include <iostream>
using namespace std;

class Graph
{
    int n;
    int adj[20][20];

public:
    Graph(int n)
    {
        this->n = n;

        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                adj[i][j] = 0;
    }

    void addEdge(int u, int v)
    {
        adj[u][v] = 1;
        adj[v][u] = 1;
    }

    void dfs(int start)
    {
        int stack[20];
        bool visited[20] = {false};
        int top = -1;

        stack[++top] = start;

        cout << "DFS: ";

        while (top != -1)
        {
            int node = stack[top--];

            if (!visited[node])
            {
                visited[node] = true;
                cout << node << " ";

                for (int i = n - 1; i >= 0; i--)
                {
                    if (adj[node][i] == 1 && !visited[i])
                        stack[++top] = i;
                }
            }
        }

        cout << endl;
    }

    void bfs(int start)
    {
        int queue[20];
        bool visited[20] = {false};
        int front = 0, rear = 0;

        queue[rear++] = start;
        visited[start] = true;

        cout << "BFS: ";

        while (front < rear)
        {
            int node = queue[front++];

            cout << node << " ";

            for (int i = 0; i < n; i++)
            {
                if (adj[node][i] == 1 && !visited[i])
                {
                    visited[i] = true;
                    queue[rear++] = i;
                }
            }
        }

        cout << endl;
    }
};

int main()
{
    int n, e;

    cout << "Enter number of buildings: ";
    cin >> n;

    Graph g(n);

    cout << "Enter number of roads: ";
    cin >> e;

    cout << "Enter roads:\n";

    for (int i = 0; i < e; i++)
    {
        int u, v;
        cin >> u >> v;
        g.addEdge(u, v);
    }

    int start;

    cout << "Enter starting building: ";
    cin >> start;

    g.dfs(start);
    g.bfs(start);

    return 0;
}
