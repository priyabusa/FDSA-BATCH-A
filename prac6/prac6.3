#include <iostream>
#include <string>
#include <cctype>
using namespace std;

char st[100];
int top = -1;

void push(char ch) {
    st[++top] = ch;
}

char pop() {
    return st[top--];
}

char peek() {
    return st[top];
}

bool isEmpty() {
    return top == -1;
}

int precedence(char op) {
    if (op == '^')
        return 3;
    if (op == '*' || op == '/')
        return 2;
    if (op == '+' || op == '-')
        return 1;
    return 0;
}

string infixToPostfix(string exp) {
    string result = "";

    for (char ch : exp) {

        if (isspace(ch))
            continue;

        if (isalnum(ch)) {
            result += ch;
            result += ' ';
        }
        else if (ch == '(') {
            push(ch);
        }
        else if (ch == ')') {

            while (!isEmpty() && peek() != '(') {
                result += pop();
                result += ' ';
            }

            if (!isEmpty() && peek() == '(')
                pop();
        }
        else {

            while (!isEmpty() &&
                   peek() != '(' &&
                   precedence(peek()) >= precedence(ch)) {
                result += pop();
                result += ' ';
            }

            push(ch);
        }
    }

    while (!isEmpty()) {
        result += pop();
        result += ' ';
    }

    return result;
}

int main() {
    string exp;

    cout << "Enter infix expression: ";
    getline(cin, exp);

    cout << "Postfix expression: "
         << infixToPostfix(exp) << endl;

    return 0;
}
