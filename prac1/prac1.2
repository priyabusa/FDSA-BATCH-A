#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter number of borrow records: ";
    cin >> n;

    int arr[n];

    cout << "Enter Book IDs: ";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    cout << "\nBook ID\tCount\n";

    for(int i = 0; i < n; i++)
    {
        bool alreadyPrinted = false;
         for(int k = 0; k < i; k++)
        {
            if(arr[i] == arr[k])
            {
                alreadyPrinted = true;
                break;
            }
        }

        if(alreadyPrinted)
            continue;

        int count = 1;

        for(int j = i + 1; j < n; j++)
        {
            if(arr[i] == arr[j])
            {
                count++;
            }
        }

        if(count > 1)
        {
            cout << arr[i] << "\t" << count << endl;
        }
    }

    return 0;
}
