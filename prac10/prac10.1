#include <iostream>
using namespace std;

#define SIZE 10

int main()
{
    int table[SIZE];
    int n, reg, index;


    for (int i = 0; i < SIZE; i++)
        table[i] = -1;

    cout << "Enter number of vehicles: ";
    cin >> n;

    cout << "Enter vehicle registration numbers:\n";

    for (int i = 0; i < n; i++)
    {
        cin >> reg;


        index = reg % 10;


        while (table[index] != -1)
        {
            index = (index + 1) % SIZE;
        }

        table[index] = reg;
    }

    cout << "\nFinal Parking Slots:\n";

    for (int i = 0; i < SIZE; i++)
    {
        if (table[i] == -1)
            cout << "Slot " << i << ": Empty\n";
        else
            cout << "Slot " << i << ": " << table[i] << "\n";
    }

    return 0;
}
