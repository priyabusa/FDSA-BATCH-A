#include <iostream>
#include <string>
using namespace std;

int searchPlate(string plates[], int n, string target, int index) {

    if (index == n) {
        return -1;
    }
    if (plates[index] == target) {
        return index;
    }
    return searchPlate(plates, n, target, index + 1);
}
int main() {
    int n;

    cout << "Enter the number of license plates: ";
    cin >> n;

    string plates[n];

    cout << "Enter the license plates:\n";
    for (int i = 0; i < n; i++) {
        cin >> plates[i];
    }

    string target;
    cout << "Enter the license plate to search: ";
    cin >> target;

    int position = searchPlate(plates, n, target, 0);

    if (position != -1) {
        cout << "License plate found at position: "
             << position + 1 << endl;
        cout << "Array index: " << position << endl;
    } 
    else {
        cout << "License plate not found." << endl;
    }

    return 0;
}
