#include <iostream>
using namespace std;

int main()
{
    int n;
    cout << "Enter number of book codes: ";
    cin >> n;

    int arr[n];

    cout << "Enter sorted book codes:\n";
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    int target;
    cout << "Enter code to search: ";
    cin >> target;

    int low = 0, high = n - 1;
    int found = -1;

    while (low <= high)
    {
        int mid = (low + high) / 2;

        if (arr[mid] == target)
        {
            found = mid;
            break;
        }
        else if (target < arr[mid])
        {
            high = mid - 1;
        }
        else
        {
            low = mid + 1;
        }
    }

    if (found != -1)
        cout << "Book code found at position: " << found + 1 << endl;
    else
        cout << "Book code not found." << endl;

    return 0;
}
